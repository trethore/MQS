{
  "schemaVersion": 1,
  "id": "myqolpackages",
  "version": "${version}",
  "name": "My QOL Packages",
  "description": "A client-side Minecraft mod for creating and sharing packages that modify the game at runtime through a built-in API and JavaScript engine.",
  "authors": [
    "trethore"
  ],
  "contact": {
    "sources": "https://github.com/trethore/myqolpackages"
  },
  "license": "AGPL-3.0-or-later",
  "icon": "assets/myqolpackages/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "io.github.trethore.myqolpackages.FabricBootstrap"
    ]
  },
  "mixins": [
    "myqolpackages.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "~${minecraftVersion}",
    "java": ">=21",
    "fabric-api": ">=${fabricApiVersion}"
  }
}
