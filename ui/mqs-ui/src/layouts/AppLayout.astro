---
import { AppNavbar } from "../components/react/AppNavbar";
import { createUiNavigationBootstrapScript, type NavItemId } from "../lib/uiNavigation";
import "../styles/globals.css";

interface Props {
  activeItem: NavItemId;
  pageRootHref: string;
  articleClassName?: string;
}

const { activeItem, pageRootHref, articleClassName = "" } = Astro.props as Props;
const navigationBootstrapScript = createUiNavigationBootstrapScript(pageRootHref);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MQS UI</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
        let themePreference = "system";

        try {
          const storedThemePreference = window.localStorage.getItem("theme");

          if (
            storedThemePreference === "dark" ||
            storedThemePreference === "light" ||
            storedThemePreference === "system"
          ) {
            themePreference = storedThemePreference;
          }
        } catch (ignored) {}

        const darkTheme =
          themePreference === "dark" || (themePreference === "system" && mediaQuery.matches);

        root.classList.toggle("dark", darkTheme);
      })();
    </script>
  </head>
  <body class="mqs-app-shell">
    <main class="mqs-app-window">
      <AppNavbar client:load activeItem={activeItem} pageRootHref={pageRootHref} />
      <script is:inline set:html={navigationBootstrapScript} />
      <section class="mqs-app-content">
        <div class="flex min-h-0 flex-1 p-4">
          <article
            class={`mqs-elevated flex min-h-0 w-full flex-col overflow-hidden rounded-2xl border border-border bg-card p-6 pb-0 ${articleClassName}`}
          >
            <slot />
          </article>
        </div>
      </section>
    </main>
  </body>
</html>
