---
import { AppNavbar } from "../components/react/AppNavbar";
import "../styles/globals.css";

type NavItemId = "scripts" | "console" | "options";

interface Props {
  activeItem: NavItemId;
}

const { activeItem } = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MQS UI</title>
    <script is:inline>
      (() => {
        const THEME_KEY = "theme";
        const root = document.documentElement;
        const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");

        const parseThemePreference = (value) => {
          if (value === "dark" || value === "light" || value === "system") {
            return value;
          }

          return "system";
        };

        const getThemePreference = () => {
          try {
            return parseThemePreference(window.localStorage.getItem(THEME_KEY));
          } catch (ignored) {
            return "system";
          }
        };

        const resolveDarkTheme = (themePreference) => {
          return themePreference === "dark" || (themePreference === "system" && mediaQuery.matches);
        };

        const applyTheme = (themePreference = getThemePreference()) => {
          const darkTheme = resolveDarkTheme(themePreference);

          root.classList.toggle("dark", darkTheme);

          return {
            themePreference,
            darkTheme,
          };
        };

        const emitThemeChange = (themeState) => {
          window.dispatchEvent(
            new CustomEvent("mqs-themechange", {
              detail: themeState,
            }),
          );
        };

        const setThemePreference = (themePreference) => {
          const normalizedThemePreference = parseThemePreference(themePreference);

          try {
            window.localStorage.setItem(THEME_KEY, normalizedThemePreference);
          } catch (ignored) {}

          const themeState = applyTheme(normalizedThemePreference);
          emitThemeChange(themeState);

          return themeState;
        };

        window.__mqsTheme = {
          getThemePreference,
          applyTheme,
          setThemePreference,
        };

        applyTheme();

        mediaQuery.addEventListener("change", () => {
          if (getThemePreference() !== "system") {
            return;
          }

          const themeState = applyTheme("system");
          emitThemeChange(themeState);
        });
      })();
    </script>
  </head>
  <body class="mqs-app-shell">
    <main class="mqs-app-window">
      <AppNavbar client:load activeItem={activeItem} />
      <section class="mqs-app-content">
        <div class="flex min-h-0 flex-1 p-4">
          <article
            class="mqs-elevated flex min-h-0 w-full flex-col overflow-hidden rounded-2xl border border-border bg-card p-6 pb-0"
          >
            <slot />
          </article>
        </div>
      </section>
    </main>
  </body>
</html>
