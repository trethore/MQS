---
import '../styles/global.css';
import Navbar from '../components/astro/Navbar.astro';

interface Props {
	title?: string;
	currentPath?: string;
}

const { title = 'MQS', currentPath = '/' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			(() => {
				const storageKey = 'mqs-theme';
				const resolveTheme = (themeChoice) => {
					if (themeChoice === 'light' || themeChoice === 'dark') {
						return themeChoice;
					}

					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				};

				try {
					const savedTheme = localStorage.getItem(storageKey);
					const resolvedTheme = resolveTheme(savedTheme);
					document.documentElement.classList.toggle('dark', resolvedTheme === 'dark');
				} catch (ignored) {
					const resolvedTheme = resolveTheme('system');
					document.documentElement.classList.toggle('dark', resolvedTheme === 'dark');
				}
			})();
		</script>
	</head>

	<body class="relative min-h-screen overflow-x-hidden">
		<div class="mqs-atmosphere pointer-events-none fixed inset-0 -z-10"></div>

		<Navbar currentPath={currentPath} />

		<main class="px-6 pb-10 pt-24">
			<slot />
		</main>
	</body>
</html>
